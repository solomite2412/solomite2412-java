
class Solution {
    public String reversePrefix(String word, char ch) {

        int index = word.indexOf(ch);

        if (index == -1) {
            return word;
        }

        StringBuilder str = new StringBuilder(word);

        int left = 0;
        int right = index;

        while (left < right) {

            char temp = str.charAt(left);

            str.setCharAt(left, str.charAt(right));
            str.setCharAt(right, temp);

            left++;
            right--;
        }

        return str.toString();
    }
}
